<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- TASK-12b: /img reads the locked clipboard block in place (UnmanagedMemoryStream over the GlobalLock pointer) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- TASK-07 §3.1: Windows DPAPI (ProtectedData) for gemini_key.dpapi; calls are guarded by OperatingSystem.IsWindows() -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- TASK-12 ADR-61: GDI+ JPEG encoder, PNG/BMP decoder and screen copy for /img and /snap (first-party, Windows-only APIs;
         every call sits behind OperatingSystem.IsWindows() or a [SupportedOSPlatform("windows")] member) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <!-- TASK-18 ADR-71: SAPI dictation + voices for /ptt local STT (first-party, Windows-only). Used only by SttWorkerServer
         ([SupportedOSPlatform("windows")]) inside the short-lived McpTools STT worker child; the HostService never loads it. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
