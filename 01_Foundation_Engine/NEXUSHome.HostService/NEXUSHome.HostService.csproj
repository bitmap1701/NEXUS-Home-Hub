<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Gate 2 decision 3: PerMonitorV2 DPI awareness (MSI G272 and LG may use different scaling). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEXUSHome.Core\NEXUSHome.Core.csproj" />
    <ProjectReference Include="..\NEXUSHome.CockpitUI\NEXUSHome.CockpitUI.csproj" />
  </ItemGroup>

</Project>
