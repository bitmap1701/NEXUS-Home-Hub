<Window x:Class="NEXUSHome.CockpitUI.CockpitShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Home Hub Cockpit"
        Width="1080"
        Height="330"
        MinHeight="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ToolTipService.InitialShowDelay="350"
        KeyDown="OnWindowKeyDown"
        MouseEnter="OnHudActivity"
        PreviewMouseWheel="OnHudActivity">

    <Window.Resources>
        <!-- TASK-16 B4: any trimmed label shows its full text on hover -->
        <Style x:Key="TrimmedText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <Style x:Key="MfdHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="PinSlot" TargetType="TextBlock" BasedOn="{StaticResource TrimmedText}">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="MaxHeight" Value="30" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="QuickSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Zero BlurEffect / Zero DropShadowEffect to preserve 100% iGPU Intel UHD 730 (24 EUs) frame budget -->
        <!-- TASK-16b CUI-Opaque: 99 % opaque backdrop, the window behind no longer shows through (click-through mode still 60 %) -->
        <Border x:Name="ChromeBorder"
                Background="#FC090D16"
                BorderBrush="#3338BDF8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6,10,6"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar (26 px): drag to move, double-click = Collapsed / Half (TASK-16 U1) -->
                <Border x:Name="TopBar"
                        Grid.Row="0"
                        Height="26"
                        Background="Transparent"
                        BorderBrush="#3338BDF8"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,6"
                        MouseLeftButtonDown="OnTopBarMouseLeftButtonDown"
                        ToolTip="Kéo để di chuyển · Nhấp đúp: Thu gọn ↔ Nửa · F1: phím tắt">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="NEXUS // COCKPIT"
                                       Foreground="#E2E8F0"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="13" />
                            <TextBlock x:Name="MfdModeBadgeText"
                                       Text="[MFD: QA_HISTORY]"
                                       Foreground="#38BDF8"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Margin="10,0,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="UiStateBadgeText"
                                   Grid.Column="1"
                                   Text=""
                                   Foreground="#2DD4BF"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />

                        <!-- TASK-16b: MCP notify_shift_complete lights this up (visible even at 40 px); Alt+A shows the details -->
                        <TextBlock x:Name="ShiftBadgeText"
                                   Grid.Column="2"
                                   Style="{StaticResource TrimmedText}"
                                   Text=""
                                   Foreground="#34D399"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="10,0,0,0"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="LatencyBadgeText"
                                   Grid.Column="3"
                                   Style="{StaticResource TrimmedText}"
                                   Text="MODE: Micro | HUD: PASSIVE | Private WS: - MB / 60 MB | WAKE: 0.00ms"
                                   Foreground="#94A3B8"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   MaxWidth="620"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Main 3-pane cockpit (hidden while Collapsed) -->
                <Grid x:Name="MainPanes" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT MFD: one Private WS figure, the same text as the top badge (TASK-16 B2) -->
                    <Border Grid.Column="0"
                            Background="#141E293B"
                            BorderBrush="#3338BDF8"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="LeftMfdHeaderText"
                                       Style="{StaticResource MfdHeader}"
                                       Text="LEFT MFD // LỊCH SỬ HỎI–ĐÁP"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="LeftMfdMemoryText"
                                       Style="{StaticResource TrimmedText}"
                                       Foreground="#F8FAFC"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       FontSize="11.5"
                                       Margin="0,0,0,4"
                                       Text="Private WS: - MB / 60 MB" />
                            <TextBlock x:Name="LeftMfdContentText"
                                       Foreground="#E2E8F0"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Text="SQLite Mode : WAL (5000ms)&#x0a;Audit Logs  : 0 records&#x0a;Memories    : 0 records&#x0a;CPU Threads : 12 (i5-12400)" />
                            <!-- TASK-16b CUI-Layout: newest real Q&A (no test rows); click or Up/Down with an empty command box -->
                            <StackPanel x:Name="HistoryPanel" />
                            <TextBlock x:Name="HistoryHintText"
                                       Text="↑↓ khi ô lệnh trống · nhấp để xem lại · Alt+Q: trang khác"
                                       Foreground="#475569"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- CENTER: command box, compact squad card, then the latest AI answer fills the rest (TASK-16 B3) -->
                    <Border Grid.Column="1"
                            Background="#141E293B"
                            BorderBrush="#3338BDF8"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#FF0F172A"
                                    BorderBrush="#6638BDF8"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,3"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="NEXUS&gt;"
                                               Foreground="#38BDF8"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock x:Name="CommandHintText"
                                               Grid.Column="1"
                                               Text="Gõ nhiệm vụ hoặc /ask, /g, /calc, /timer, /note, /ui, /watch · Enter: gửi · Esc: về game · F1: phím tắt"
                                               Foreground="#475569"
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0"
                                               IsHitTestVisible="False"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="CommandInputBox"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             Foreground="#F8FAFC"
                                             CaretBrush="#38BDF8"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnCommandTextChanged"
                                             PreviewKeyDown="OnCommandInputPreviewKeyDown"
                                             KeyDown="OnCommandInputKeyDown" />
                                </Grid>
                            </Border>

                            <!-- TASK-04 Active Squad card; TASK-05 border / title colour = Dev-QA status -->
                            <Border x:Name="DispatchCardBorder"
                                    Grid.Row="1"
                                    Background="#FF0B1220"
                                    BorderBrush="#5534D399"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DispatchCardTitle"
                                                   Style="{StaticResource TrimmedText}"
                                                   Text="ACTIVE SQUAD // chưa có lượt điều phối"
                                                   Foreground="#34D399"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   FontSize="11" />
                                        <TextBlock x:Name="DispatchCardStatus"
                                                   Grid.Column="1"
                                                   Text="[—]"
                                                   Foreground="#38BDF8"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="DispatchCardAgents"
                                               Style="{StaticResource TrimmedText}"
                                               Text="Primary: -   QA: -   Gate: Reality Checker"
                                               Foreground="#E2E8F0"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                    <TextBlock x:Name="DispatchCardMeta"
                                               Style="{StaticResource TrimmedText}"
                                               Text="Dispatch ID: -   Latency: -   Mode: Micro"
                                               Foreground="#94A3B8"
                                               FontFamily="Consolas"
                                               FontSize="10.5"
                                               Margin="0,1,0,0" />
                                    <TextBlock x:Name="DispatchCardTask"
                                               Style="{StaticResource TrimmedText}"
                                               Text=""
                                               Foreground="#CBD5E1"
                                               FontFamily="Consolas"
                                               FontSize="10.5"
                                               Margin="0,1,0,0" />
                                    <TextBlock x:Name="DispatchCardEvidence"
                                               Style="{StaticResource TrimmedText}"
                                               Text=""
                                               Foreground="#94A3B8"
                                               FontFamily="Consolas"
                                               FontSize="10.5"
                                               Margin="0,1,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!-- Latest answer area: AI (TASK-07) fills, QA review (TASK-08) below it -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="AiResponseHeader"
                                           Grid.Row="0"
                                           Style="{StaticResource TrimmedText}"
                                           Text="AI RESPONSE"
                                           Foreground="#A78BFA"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="10.5"
                                           Margin="0,0,0,2"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="AiResponseScroll"
                                              Grid.Row="1"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="Collapsed">
                                    <TextBlock x:Name="AiResponseText"
                                               Text=""
                                               Foreground="#F1F5F9"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               LineHeight="17"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock x:Name="AiEmptyText"
                                           Grid.Row="1"
                                           Text="Chưa có câu trả lời. Ctrl+Shift+Space rồi gõ /ask câu hỏi."
                                           Foreground="#475569"
                                           FontFamily="Consolas"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top" />
                                <!-- TASK-16b CUI-Lazy: number keys after an answer (command box empty) -->
                                <TextBlock x:Name="SuggestionsText"
                                           Grid.Row="2"
                                           Text=""
                                           Foreground="#2DD4BF"
                                           FontFamily="Consolas"
                                           FontSize="10.5"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="QaResponseHeader"
                                           Grid.Row="3"
                                           Style="{StaticResource TrimmedText}"
                                           Text="QA REVIEW"
                                           Foreground="#F472B6"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           FontSize="10.5"
                                           Margin="0,6,0,2"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="QaResponseScroll"
                                              Grid.Row="4"
                                              MaxHeight="90"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="Collapsed">
                                    <TextBlock x:Name="QaResponseText"
                                               Text=""
                                               Foreground="#E2E8F0"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT MFD: switches, HUD options, pins, timers, recent dispatches (scrolls in Half) -->
                    <Border Grid.Column="2"
                            Background="#141E293B"
                            BorderBrush="#3338BDF8"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <ScrollViewer Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MfdHeader}" Text="RIGHT MFD // QUICK SWITCHES" Margin="0,0,0,6" />

                                <CheckBox x:Name="ToggleGameBoost" Style="{StaticResource QuickSwitch}" Content="1. Game Boost (Delta Force)"
                                          Checked="OnQuickSwitchChanged" Unchecked="OnQuickSwitchChanged" />
                                <CheckBox x:Name="ToggleIgpuLock" Style="{StaticResource QuickSwitch}" Content="2. iGPU UHD 730 Eco Lock" IsChecked="True"
                                          Checked="OnQuickSwitchChanged" Unchecked="OnQuickSwitchChanged" />
                                <CheckBox x:Name="ToggleVoicePtt" Style="{StaticResource QuickSwitch}" Content="3. Mic 16kHz VAD Stream"
                                          Checked="OnQuickSwitchChanged" Unchecked="OnQuickSwitchChanged" />
                                <CheckBox x:Name="ToggleGovernanceStrict" Style="{StaticResource QuickSwitch}" Content="4. 3-Tier Gate (HITL Red)" IsChecked="True"
                                          Checked="OnQuickSwitchChanged" Unchecked="OnQuickSwitchChanged" />

                                <!-- TASK-16 U1 options (saved in config/cockpit_ui.json) -->
                                <CheckBox x:Name="ToggleAutoCollapse" Style="{StaticResource QuickSwitch}" Content="5. Tự thu gọn sau 30 s rảnh"
                                          ToolTip="PASSIVE + không thao tác 30 s → thu về 40 px; câu trả lời mới mở lại"
                                          Checked="OnUiOptionChanged" Unchecked="OnUiOptionChanged" />
                                <CheckBox x:Name="ToggleClickThrough" Style="{StaticResource QuickSwitch}" Content="6. Xuyên thấu chuột (PASSIVE)"
                                          ToolTip="HUD mờ 60 %, chuột đi xuyên xuống cửa sổ phía sau. Ctrl+Shift+Space: rõ lại và gõ lệnh"
                                          Checked="OnUiOptionChanged" Unchecked="OnUiOptionChanged" />

                                <!-- TASK-13 pins (5 fixed reused slots) + TASK-16 B5 card label + timers -->
                                <TextBlock x:Name="MfdPinsHeaderText" Style="{StaticResource MfdHeader}" Text="PINNED MFD CARDS (0/5)" Margin="0,6,0,4" />
                                <TextBlock x:Name="WidgetIndicatorText"
                                           Text="Câu trả lời hiện tại: 0 thẻ"
                                           Foreground="#2DD4BF"
                                           FontFamily="Consolas"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="[0 thẻ | Alt+P: Pin kết quả]"
                                           Margin="0,0,0,4" />
                                <TextBlock x:Name="MfdPin1Text" Style="{StaticResource PinSlot}" Text="" />
                                <TextBlock x:Name="MfdPin2Text" Style="{StaticResource PinSlot}" Text="" />
                                <TextBlock x:Name="MfdPin3Text" Style="{StaticResource PinSlot}" Text="" />
                                <TextBlock x:Name="MfdPin4Text" Style="{StaticResource PinSlot}" Text="" />
                                <TextBlock x:Name="MfdPin5Text" Style="{StaticResource PinSlot}" Text="" />
                                <TextBlock x:Name="MfdTimerText"
                                           Style="{StaticResource TrimmedText}"
                                           Text=""
                                           Foreground="#FBBF24"
                                           FontFamily="Consolas"
                                           FontSize="10.5"
                                           Margin="0,0,0,2" />

                                <!-- TASK-04 recent dispatches (TASK-16 B1: no test records in the real Cockpit) -->
                                <TextBlock Style="{StaticResource MfdHeader}" Text="RECENT DISPATCHES" Margin="0,6,0,4" />
                                <TextBlock x:Name="RecentDispatchesText"
                                           Text="(trống)"
                                           Foreground="#CBD5E1"
                                           FontFamily="Consolas"
                                           FontSize="10.5"
                                           LineHeight="15"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- TASK-16 B3: system log as one status line; hover = last 10 lines -->
                <TextBlock x:Name="StatusLineText"
                           Grid.Row="2"
                           Text="[SYSTEM] NEXUS Cockpit"
                           Foreground="#64748B"
                           FontFamily="Consolas"
                           FontSize="10.5"
                           Margin="2,5,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ShowDuration="60000" />

                <!-- Bottom hint bar; the resize grip overlays the bottom edge -->
                <TextBlock x:Name="HintBarText"
                           Grid.Row="3"
                           Text="F1: phím tắt  ·  Alt+A: liên minh  ·  Alt+Enter: chép bước kế tiếp  ·  kéo viền dưới ↕  ·  Ctrl+Shift+Space: gõ lệnh"
                           Foreground="#475569"
                           FontFamily="Consolas"
                           FontSize="10.5"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,4" />
            </Grid>
        </Border>

        <!-- TASK-16 B4: F1 cheat sheet (only while the Cockpit has keyboard focus; no global hotkey) -->
        <Border x:Name="CheatSheetPanel"
                Visibility="Collapsed"
                Background="#F2090D16"
                BorderBrush="#6638BDF8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,10"
                Margin="40,34,40,18">
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="PHÍM TẮT NEXUS COCKPIT  (F1 / Esc: đóng)" Foreground="#38BDF8" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock x:Name="CheatSheetText"
                               Foreground="#E2E8F0"
                               FontFamily="Consolas"
                               FontSize="11.5"
                               LineHeight="18"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- TASK-16b CUI-Alliance: Alt+A (only while the Cockpit has keyboard focus) -->
        <Border x:Name="AlliancePanel"
                Visibility="Collapsed"
                Background="#FC090D16"
                BorderBrush="#6634D399"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,10"
                Margin="40,34,40,18">
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="BẢNG ĐIỀU PHỐI LIÊN MINH  (Alt+A / Esc: đóng · Alt+Enter: chép bước kế tiếp)" Foreground="#34D399" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock x:Name="AllianceText"
                               Foreground="#E2E8F0"
                               FontFamily="Consolas"
                               FontSize="11.5"
                               LineHeight="18"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- TASK-16 U1: bottom resize grip (drag, release = snap to 40 / 330 / 640 px, no animation; double-click = toggle) -->
        <Border x:Name="ResizeGripHost"
                VerticalAlignment="Bottom"
                Height="8"
                Background="Transparent"
                PreviewMouseLeftButtonDown="OnGripPreviewMouseLeftButtonDown">
            <Thumb x:Name="ResizeGrip"
                   Cursor="SizeNS"
                   DragStarted="OnGripDragStarted"
                   DragDelta="OnGripDragDelta"
                   DragCompleted="OnGripDragCompleted"
                   ToolTip="Kéo ↕: 40 / 330 / 640 px · Nhấp đúp: Thu gọn ↔ Nửa">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border Width="64" Height="3" CornerRadius="1.5" Background="#5538BDF8" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Border>
    </Grid>
</Window>
